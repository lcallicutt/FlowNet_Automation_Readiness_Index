# Neon Postgres connection string.
# On Vercel this is injected automatically when you create a Neon database
# in the project's Storage tab. For local dev, copy the value from
# Vercel → Project → Storage → your Neon database → ".env.local" snippet.
DATABASE_URL=

# GoHighLevel inbound webhook for ASSESSMENT submissions (optional).
# Payload: name, email, tier, top_weakest_category.
# Leave empty to disable — the assessment flow works without it.
GHL_WEBHOOK_URL=

# GoHighLevel inbound webhook for WEBSITE AUDIT submissions (optional).
# Payload: business_name, email, website, audit_score, audit_grade,
# top_weakest_area.
# Deliberately a separate webhook from the assessment one — the payloads
# share only `email`, so each flow gets its own endpoint. There is no
# fallback: if this is unset the audit notification is skipped rather than
# posted to GHL_WEBHOOK_URL.
AUDIT_GHL_WEBHOOK_URL=

# Google PageSpeed Insights API key (optional but recommended).
# Powers the real Lighthouse mobile + SEO scores in the website audit.
# Create one at console.cloud.google.com → enable "PageSpeed Insights API"
# → Credentials → API key. Without it the API is called unauthenticated at a
# very low rate limit; if that fails, those two ratings fall back to
# markup-only heuristics and the UI says so.
PAGESPEED_API_KEY=
