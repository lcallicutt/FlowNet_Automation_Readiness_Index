# Neon Postgres connection string.
# On Vercel this is injected automatically when you create a Neon database
# in the project's Storage tab. For local dev, copy the value from
# Vercel → Project → Storage → your Neon database → ".env.local" snippet.
DATABASE_URL=

# GoHighLevel inbound webhook URL (optional).
# When set, a small notification payload is POSTed after each assessment
# and each website audit is saved.
# Leave empty to disable — both flows work without it.
GHL_WEBHOOK_URL=

# Google PageSpeed Insights API key (optional but recommended).
# Powers the real Lighthouse mobile + SEO scores in the website audit.
# Create one at console.cloud.google.com → enable "PageSpeed Insights API"
# → Credentials → API key. Without it the API is called unauthenticated at a
# very low rate limit; if that fails, those two ratings fall back to
# markup-only heuristics and the UI says so.
PAGESPEED_API_KEY=
