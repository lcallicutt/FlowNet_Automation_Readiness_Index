# Neon Postgres connection string.
# On Vercel this is injected automatically when you create a Neon database
# in the project's Storage tab. For local dev, copy the value from
# Vercel → Project → Storage → your Neon database → ".env.local" snippet.
DATABASE_URL=

# GoHighLevel inbound webhook URL (optional).
# When set, a small notification payload (name, email, tier,
# top_weakest_category) is POSTed after each assessment is saved.
# Leave empty to disable — the assessment flow works without it.
GHL_WEBHOOK_URL=
